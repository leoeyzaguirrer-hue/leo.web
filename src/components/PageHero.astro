---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero bg-blue">
  <div class="wrap">
    <div class="page-hero__inner">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h1 h1--page">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
<div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>
