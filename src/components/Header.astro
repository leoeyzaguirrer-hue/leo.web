---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { menu, whatsappUrl, waMessages, type MenuGroup, type MenuLink } from '../config/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const isGroup = (item: MenuLink | MenuGroup): item is MenuGroup => 'items' in item;
const slug = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z]+/g, '-');
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="Leo Eyzaguirre, psicoterapeuta. Ir al inicio">
      <Image src={logo} alt="" width={222} height={92} loading="eager" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú" data-nav-toggle>
      <span></span>
    </button>
    <nav class="nav" id="menu" aria-label="Principal" data-nav>
      {
        menu.map((item) =>
          isGroup(item) ? (
            <div class:list={['nav__group', item.items.some((i) => isCurrent(i.href)) && 'has-current']} data-dropdown>
              <button class="nav__trigger" type="button" aria-expanded="false" aria-controls={`menu-${slug(item.label)}`}>
                {item.label}
                <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div class="nav__panel" id={`menu-${slug(item.label)}`}>
                {item.items.map((sub) => (
                  <a href={sub.href} aria-current={isCurrent(sub.href) ? 'page' : undefined}>
                    <span class="hexdot" aria-hidden="true" />
                    <span>
                      <b>{sub.label}</b>
                      {sub.desc && <small>{sub.desc}</small>}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
      <a class="btn btn--wa btn--sm" href={whatsappUrl(waMessages.agendar)} target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon size={20} />
        Agendar
      </a>
    </nav>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>
