---
import { site, footerNav, whatsappUrl } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer site-footer--navy bg-navy">
  <div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="wrap site-footer__grid">
    <div class="site-footer__about">
      <a class="wordmark" href="/" aria-label="Leo Eyzaguirre, psicoterapeuta. Ir al inicio">
        <b>Leo Eyzaguirre</b>
        <span>PSICOTERAPEUTA</span>
      </a>
      <p>Psicoterapia conductual-contextual basada en evidencia. Presencial en La Paz, Bolivia, y online en Bolivia y el exterior.</p>
    </div>
    <nav aria-label="Pie de página">
      <h2>Secciones</h2>
      <ul class="site-footer__links">
        {footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2>Contacto</h2>
      <ul>
        <li><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">WhatsApp · {site.whatsappDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.instagram.map((ig) => <li><a href={ig.url} target="_blank" rel="noopener noreferrer">Instagram · {ig.handle}</a></li>)}
        <li>{site.address.full}</li>
      </ul>
    </div>
  </div>
  <div class="wrap site-footer__bottom">
    <span>© {year} {site.fullName}</span>
    <span>Si estás en crisis o en riesgo, acude al servicio de emergencias más cercano.</span>
  </div>
</footer>
