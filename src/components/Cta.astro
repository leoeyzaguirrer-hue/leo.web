---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site, whatsappUrl, waMessages } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
  button?: string;
}
const {
  title = 'Dar el primer paso no requiere tenerlo todo claro',
  text = 'Escríbeme y conversamos. Coordinamos tu primera sesión, presencial u online.',
  message = waMessages.agendar,
  button = `WhatsApp · ${site.whatsappDisplay}`,
} = Astro.props;
---

<section class="bg-yellow sec sec--sm no-print">
  <div class="wrap cta-band" data-reveal="zoom">
    <span class="hxb hx-navy" aria-hidden="true"></span>
    <p class="cta-band__title">{title}</p>
    <p>{text}</p>
    <a class="btn btn--navy btn--lg" href={whatsappUrl(message)} target="_blank" rel="noopener noreferrer">
      <WhatsAppIcon size={22} />
      {button}
    </a>
  </div>
</section>
