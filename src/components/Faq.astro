---
import type { Pregunta } from '../data/faq';

interface Props {
  items: Pregunta[];
  variant?: 'yellow' | 'blue';
}
const { items, variant = 'yellow' } = Astro.props;
---

<div class:list={['faq', 'faq--plus', variant === 'blue' && 'faq--blue']} data-reveal-group>
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>
