---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { site, whatsappUrl, waMessages } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Mensaje prellenado del botón flotante de WhatsApp en esta página. */
  waMessage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Datos estructurados adicionales (schema.org). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  waMessage = waMessages.general,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  jobTitle: site.roleShort,
  url: Astro.site?.href,
  image: ogImage.href,
  sameAs: site.instagram.map((i) => i.url),
  address: { '@type': 'PostalAddress', addressLocality: site.address.city, addressCountry: site.address.country },
};
const jsonLd = [person, ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0553A0" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`Blog · ${site.name}`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/cocogoose-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}

    <script is:inline src="/js/boot.js"></script>
    <script is:inline src="/js/main.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <a class="wa-fab" href={whatsappUrl(waMessage)} target="_blank" rel="noopener noreferrer" aria-label="Escríbeme por WhatsApp">
      <WhatsAppIcon size={28} />
      <span>Escríbeme</span>
    </a>
  </body>
</html>
