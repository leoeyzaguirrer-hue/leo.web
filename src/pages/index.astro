---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import foto from '../assets/leo-consultorio.jpg';
import { site, whatsappUrl, waMessages } from '../config/site';

// Cada tarjeta lleva a su propia página.
const secciones = [
  { n: '01', href: '/quien-soy', tag: 'Presentación', titulo: 'Quién soy', texto: 'Quién soy, la base científica de mi trabajo y qué hace un terapeuta conductual-contextual.', color: 'hx-yellow' },
  { n: '02', href: '/como-trabajo', tag: 'Método', titulo: 'Cómo trabajo', texto: 'Análisis funcional, flexibilidad psicológica y los motivos de consulta que acompaño.', color: 'hx-navy' },
  { n: '03', href: '/enfoques', tag: 'Modelos', titulo: 'Enfoques', texto: 'ACT, FAP, Activación Conductual y DBT: para qué sirve cada uno y cómo funciona.', color: 'hx-blue' },
  { n: '04', href: '/proceso', tag: 'Paso a paso', titulo: 'El proceso', texto: 'Del primer contacto al cierre, y las modalidades presencial y online.', color: 'hx-navy' },
  { n: '05', href: '/tarifas', tag: 'Inversión', titulo: 'Tarifas', texto: 'Precios por sesión y paquetes, en Bolivia y desde el exterior.', color: 'hx-yellow' },
  { n: '06', href: '/hoja-de-vida', tag: 'Trayectoria', titulo: 'Hoja de vida', texto: 'Formación, práctica clínica, docencia, cursos y actividad académica.', color: 'hx-deep' },
  { n: '07', href: '/preguntas-frecuentes', tag: 'Dudas', titulo: 'Preguntas frecuentes', texto: 'Tu primera sesión, confidencialidad, pagos y consentimiento informado.', color: 'hx-blue' },
  { n: '08', href: '/blog', tag: 'Lecturas', titulo: 'Blog', texto: 'Artículos sobre psicología contextual, en lenguaje claro.', color: 'hx-yellow' },
  { n: '09', href: '/contacto', tag: 'Escríbeme', titulo: 'Contacto', texto: 'WhatsApp, correo, Instagram y dirección del consultorio.', color: 'hx-navy' },
];
---

<Base waMessage={waMessages.agendar}>
  <section class="hero bg-navy">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Psicoterapia basada en evidencia</p>
        <h1 class="h1">Hola, soy Leo</h1>
        <p class="hero__role">{site.role}</p>
        <p class="lead hero__lead">
          No vamos a pelear contra lo que sientes ni a buscar qué está “roto” en ti. Vamos a entender para qué funciona lo que haces en
          tu contexto, y a construir contigo pasos concretos hacia una vida que valga la pena.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={whatsappUrl(waMessages.agendar)} target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon size={22} /> Agendar por WhatsApp
          </a>
          <a class="btn btn--ghost" href="/quien-soy">Conóceme <Icon name="arrow" size={18} /></a>
        </div>
        <div class="hero__meta">
          <span><Icon name="home" size={18} /> Presencial en La Paz, Bolivia</span>
          <span><Icon name="video" size={18} /> Online, en Bolivia y el exterior</span>
        </div>
      </div>
      <div class="hero__art">
        <div class="hexes">
          <div class="hexes__yellow" aria-hidden="true"></div>
          <div class="hexes__navy hx-blue" aria-hidden="true"></div>
          <div class="hexes__white" aria-hidden="true"></div>
          <Image
            class="hexes__photo"
            src={foto}
            alt="Fotografía de Leo Eyzaguirre sonriendo en su consultorio"
            width={640}
            height={740}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
    <div class="creds">
      <ul class="wrap creds__list">
        <li><span class="hexdot" aria-hidden="true"></span>Máster en Análisis Funcional del Comportamiento</li>
        <li><span class="hexdot" aria-hidden="true"></span>Formación en ACT, FAP, DBT, AC, PBBT e IBT</li>
        <li><span class="hexdot" aria-hidden="true"></span>Socio fundador de la ABTCC</li>
      </ul>
    </div>
    <div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>

  <!-- Explora: cada tarjeta lleva a su página -->
  <section class="sec bg-dots">
    <div class="wrap">
      <div class="section__head section__head--center" data-reveal>
        <p class="eyebrow eyebrow--blue">Explora</p>
        <h2 class="h2 h2--xl">¿Qué te gustaría conocer?</h2>
        <p class="txt">Cada sección tiene su propio espacio. Elige por dónde empezar.</p>
      </div>
      <div class="explore" data-reveal-group>
        {
          secciones.map((s) => (
            <a class="xcard" href={s.href}>
              <span class="xcard__top">
                <span class:list={['hxb', s.color]}>{s.n}</span>
                <span class="xcard__tag">{s.tag}</span>
              </span>
              <span class="xcard__title">{s.titulo}</span>
              <p>{s.texto}</p>
              <span class="link-arrow">Entrar <Icon name="arrow" size={18} /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Frase -->
  <section class="sec bg-deep">
    <div class="wrap quote-band" data-reveal>
      <span class="hxb hxb--sm hx-yellow" aria-hidden="true"></span>
      <p class="quote-band__text">El objetivo no es dejar de sentir. Es que el malestar deje de decidir por ti.</p>
      <p class="txt txt--light">
        Lo que haces, sientes y piensas tiene una historia y ocurre en un contexto. Cuando entendemos para qué funciona, podemos elegir
        qué hacer distinto.
      </p>
      <a class="link-arrow" href="/como-trabajo">Ver cómo trabajo <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <Cta />
</Base>
