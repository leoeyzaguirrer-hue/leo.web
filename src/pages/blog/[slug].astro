---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { site, waMessages } from '../../config/site';
import { formatDate } from '../../config/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.fullName },
};
---

<Base title={post.data.title} description={post.data.description} ogType="article" waMessage={waMessages.blog} schema={[schema]}>
  <PageHero eyebrow="Blog" title={post.data.title} lead={post.data.description}>
    <p class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {post.data.tags.length > 0 && <span> · {post.data.tags.join(' · ')}</span>}
    </p>
  </PageHero>

  <article class="section">
    <div class="wrap wrap--narrow">
      <div class="prose" data-reveal>
        <Content />
      </div>
      <p class="mt">
        <a class="link-arrow" href="/blog"><Icon name="arrow" size={18} /> Volver al blog</a>
      </p>
    </div>
  </article>

  <Cta message={waMessages.blog} />
</Base>
